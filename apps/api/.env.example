DATABASE_URL="postgresql://bio_admin:bio_admin_password@localhost:5432/bio_platform?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
WEB_URL="http://localhost:3000"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# Envío de email (recuperación de contraseña). Sin SMTP_HOST configurado,
# los correos se registran en el log del servidor en vez de enviarse de
# verdad — útil en desarrollo, no lo dejes así en producción.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Aura <no-reply@aura.local>"

# Usados solo por `prisma db seed` — cambia la contraseña antes de producción.
# SEED_USERNAME no puede ser "admin", "api", "login" ni otras rutas reservadas
# del frontend (ver src/common/constants/reserved-usernames.ts).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_USERNAME="me"
SEED_DISPLAY_NAME="Mi Perfil"
